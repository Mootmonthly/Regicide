; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Regicide"
config/description="Medieval 50v50 arena battler: gather, build, craft, and steal the enemy crown."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Net="*res://autoload/net.gd"
Controls="*res://autoload/controls.gd"
Sfx="*res://autoload/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="players"
3d_physics/layer_3="structures"
3d_physics/layer_4="resources"
3d_physics/layer_5="azure_gates"
3d_physics/layer_6="crimson_gates"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
